#######################################
# 2025-03-24
# ori_bam2fq2bam
# env: CHIP-seq
# REQUIRES: source ../config.sh before running snakemake
#######################################

import os

INDEX_BT2 = os.path.join(os.environ["BT2_INDEX_DIR"], "CriGri_PUMC_clean", "CriGri_PUMC_clean")
ORI_BAM_DIR = os.environ["CHIP_ORI_BAM_DIR"]
SAMPLE = ["H3K4me1","H3K4me3","H3K9me3","H3K27ac","H3K27me3","H3K36me3","input"]
# INPUT = "sorted_bam/input_sorted.bam"

# Files listed in rule all are retained as final outputs.
rule all:
    input:
        expand("sorted_bam/{sample}_sorted.bam.csi",sample = SAMPLE),
        expand("sorted_bam/{sample}_sorted.bam",sample = SAMPLE)


# The 2016 hamster dataset was generated by single-end sequencing.
rule bam2fq:
    input:
        f"{ORI_BAM_DIR}/{{sample}}.bam"
    output:
        "fq_data/{sample}.fastq.gz"
    shell:
        "samtools fastq -@ 10 -n {input} | gzip > {output}"

rule bowtie2_mapping:
    input:
        "fq_data/{sample}.fastq.gz"
    output:
        "bt2_out/{sample}.sam"
    log:
        "bt2_out/{sample}.log"
    shell:
        "bowtie2 -p 10 -x {INDEX_BT2} -U {input} -S {output} > {log} 2>&1"

rule sort_bam:
    input:
        "bt2_out/{sample}.sam"
    output:
        "sorted_bam/{sample}_sorted.bam"
    log:
        "sorted_bam/{sample}_sort.log"
    params:
        "sorted_bam/{sample}_sorted.bam.temp"
    shell:
        "samtools sort -O BAM -m 2G -@ 10 -o {output} -T {params} {input} > {log} 2>&1"

rule samtools_index:
    input:
        "sorted_bam/{sample}_sorted.bam"
    output:
        "sorted_bam/{sample}_sorted.bam.csi"
    log:
        "sorted_bam/{sample}_index.log"
    shell:
        "samtools index -c {input} > {log} 2>&1"

# PICARD duplicate removal; see the Snakemake course notes.


# For hamster data, callpeak cannot use -g hs. The effective genome size is 2.7 Gb,
# so the -g parameter must be adjusted.
# snakemake -s SE_upstream.smk --cores 10 -n
# Add -n to perform a dry run without executing the workflow.
# Generate a workflow graph: snakemake -s SE_upstream.smk --dag | dot -Tpdf > demo_crispr_dag.pdf
# Run the workflow: snakemake -s SE_upstream.smk -p --cores 10 -j 1
# Resume incomplete jobs: snakemake -s SE_upstream.smk -p --cores 10 -j 1 --rerun-incomplete
# This dataset has two input files.


